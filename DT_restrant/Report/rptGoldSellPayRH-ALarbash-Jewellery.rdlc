  <Code>Function ShowValue(val as Object) as String
    If val Is Nothing Then
        Return ""
    End If
    If IsNumeric(val) AndAlso CDbl(val) = 0 Then
        Return ""
    End If
    Return val.ToString()
End Function

Function ConcatLines(ParamArray values() As String) As String
    Dim result As String = ""
    For Each v As String In values
        If Not String.IsNullOrEmpty(v) Then
            If result &lt;&gt; "" Then
                result = result &amp; vbCrLf
            End If
            result = result &amp; v
        End If
    Next
    Return result
End Function</Code>
