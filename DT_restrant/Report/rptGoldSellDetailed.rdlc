  <Code>Private Shared seen As New System.Collections.Hashtable()
Private Shared lastRunKey As String = ""

Private Shared Function RunKey(run As Object) As String
    If run Is Nothing OrElse run Is System.DBNull.Value Then Return ""
    If TypeOf run Is DateTime Then
        Return DirectCast(run, DateTime).ToString("o") ' ISO ثابت
    End If
    Return CStr(run)
End Function

Public Shared Function ResetSeen() As Integer
    seen.Clear()
    lastRunKey = ""
    Return 0
End Function

Private Shared Function ToDec(v As Object) As Decimal
    If v Is Nothing OrElse v Is System.DBNull.Value Then Return 0D
    Dim s As String = CStr(v).Trim()
    Dim d As Decimal
    If Decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, d) Then Return d
    If Decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, d) Then Return d
    Return 0D
End Function

' نسخة تتعامل مع الـ Refresh تلقائياً عن طريق run (Globals!ExecutionTime)
Public Shared Function UniqueTagged(tag As Object, inv As Object, total As Object, run As Object) As Decimal
    If inv Is Nothing OrElse inv Is System.DBNull.Value Then Return 0D

    Dim rk As String = RunKey(run)

    ' إذا تغير وقت التنفيذ =&gt; هذا رندر جديد (Refresh) =&gt; صفّر الذاكرة تلقائياً
    If rk &lt;&gt; lastRunKey Then
        seen.Clear()
        lastRunKey = rk
    End If

    Dim key As String = rk &amp; "|" &amp; CStr(tag) &amp; "|" &amp; CStr(inv)

    If seen.ContainsKey(key) Then
        Return 0D
    End If

    seen.Add(key, True)
    Return ToDec(total)
End Function</Code>
